# Fase 1: simulador de laboratorio, sin consumo de API.
LLM_PROVIDER=mock

# Para un proveedor real, cambiar a openai_compatible y completar:
# LLM_BASE_URL incluye el prefijo de versión; ejemplo genérico:
# https://servidor-del-proveedor/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=


# Opcional: ruta a un archivo JSON de políticas alternativo.
# GUARDRAIL_POLICY_PATH=C:\\ruta\\a\\guardrail-policy.json

# Fase 2: clasificador de prompt injection.
# none = solo reglas (fase 1); prompt_guard = Llama Prompt Guard 2 86M; piguard = PIGuard.
INJECTION_CLASSIFIER=none
# Carpeta local del modelo; vacío = /models/prompt-guard-2-86m o /models/piguard.
INJECTION_MODEL_PATH=
# Puntuación >= BLOCK bloquea; entre REVIEW y BLOCK envía a revisión.
INJECTION_BLOCK_THRESHOLD=0.90
INJECTION_REVIEW_THRESHOLD=0.50
# cpu o cuda
INJECTION_CLASSIFIER_DEVICE=cpu
